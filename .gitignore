# ============================================================
# Ichara AI Tchad - Git Ignore
# Python / Machine Learning / Flutter
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.iml

# -------------------------
# Operating System
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Environment variables
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Machine Learning
# -------------------------
*.h5
*.hdf5
*.keras
*.ckpt
*.pth
*.pt
*.onnx
*.tflite

# Model checkpoints
models/checkpoints/

# TensorBoard
logs/
runs/

# -------------------------
# Datasets
# -------------------------
data/raw/*
data/processed/*
data/landmarks/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/landmarks/.gitkeep

# Large archives
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# -------------------------
# Flutter
# -------------------------
mobile/**/.dart_tool/
mobile/**/.flutter-plugins
mobile/**/.flutter-plugins-dependencies
mobile/**/.packages
mobile/**/build/
mobile/**/.pub-cache/

# Flutter generated files
mobile/**/android/.gradle/
mobile/**/android/local.properties

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.log
*.bak
*.swp
*.swo

# -------------------------
# Secrets / credentials
# -------------------------
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account.json
